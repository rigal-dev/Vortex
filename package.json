{
  "name": "vortex",
  "private": true,
  "version": "1.0.0",
  "description": "Vortex: Shapes of Cyclones. An interactive visualization of the morphology of global major cyclone tracks, 1980 to present.",
  "keywords": ["cyclones", "hurricanes", "typhoons", "IBTrACS", "data-visualization", "canvas", "react"],
  "homepage": "https://rigal-dev.github.io/Vortex/",
  "repository": { "type": "git", "url": "git+https://github.com/rigal-dev/Vortex.git" },
  "bugs": { "url": "https://github.com/rigal-dev/Vortex/issues" },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "data": "node scripts/build-data.mjs",
    "land": "node scripts/build-land.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.0"
  }
}
